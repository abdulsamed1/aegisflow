# ==============================================================================
# AegisFlow - Environment Variables Template (.env.example)
# ==============================================================================

# Core API Security
ADMIN_API_KEY=your-admin-api-key-here

# AES-256-GCM Master Key for PII Field-Level Encryption
PII_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# Cloudflare Account & API Credentials (for local testing of Workers AI)
CF_API_TOKEN=your-cloudflare-api-token
CF_ACCOUNT_ID=your-cloudflare-account-id

# Telegram Bot Alerting Configuration
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_ID=-1001234567890

# Runtime Parameters
ENVIRONMENT=development
SCAN_BURSTS=2
PLAN_TIER=free
ENABLE_PRE_LAUNCH_REVERIFY=false
