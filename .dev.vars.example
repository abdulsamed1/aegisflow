# ==============================================================================
# AegisFlow - Local Development Secrets (.dev.vars.example)
# ==============================================================================
# Usage:
#   cp .dev.vars.example .dev.vars
#
# IMPORTANT:
#   Never commit the actual .dev.vars file to version control.
#   In production, set these via: wrangler secret put <KEY_NAME>
# ==============================================================================

# Admin API Key used for authenticating administrative requests (Bearer token)
ADMIN_API_KEY=your-admin-api-key-here

# 32-character / 256-bit AES-GCM master key used for applicant PII encryption at rest
# Generate a fresh 32-char key: openssl rand -hex 16
PII_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# Optional: Cloudflare REST API credentials for local Workers AI emulation
CF_API_TOKEN=your-cloudflare-api-token
CF_ACCOUNT_ID=your-cloudflare-account-id

# Optional: Telegram Bot credentials for real-time slot alerts and failure notifications
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_ID=-1001234567890

# Optional runtime flags
ENVIRONMENT=development
SCAN_BURSTS=2
PLAN_TIER=free
ENABLE_PRE_LAUNCH_REVERIFY=false
